<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GLAuth User Manager"
    Height="860"
    Width="1320"
    MinHeight="720"
    MinWidth="1100"
    WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True" Margin="10">
        <Border DockPanel.Dock="Top" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kubeconfig" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="KubeConfigPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" MinWidth="320"/>
                <Button x:Name="BrowseKubeConfigButton" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,8,8"/>
                <Button x:Name="RefreshContextsButton" Grid.Row="0" Grid.Column="3" Content="Refresh Contexts" Width="120" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Context" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ContextComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" Margin="0,0,0,8" MinWidth="320"/>

                <TextBlock Grid.Row="1" Grid.Column="5" Text="Namespace" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="NamespaceTextBox" Grid.Row="1" Grid.Column="6" Text="idam" Margin="0,0,0,8" MinWidth="180"/>

                <TextBlock Grid.Row="1" Grid.Column="8" Text="Data Key" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DataKeyTextBox" Grid.Row="1" Grid.Column="9" Text="config.cfg" Margin="0,0,0,8" MinWidth="180"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="ConfigMap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ConfigMapTextBox" Grid.Row="2" Grid.Column="1" Text="glauth-config" Grid.ColumnSpan="3" Margin="0,0,0,10" MinWidth="320"/>

                <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="10">
                    <Button x:Name="LoadClusterButton" Content="Load from Cluster" Width="130" Margin="0,0,8,0"/>
                    <Button x:Name="SaveClusterButton" Content="Save to Cluster" Width="130" Margin="0,0,8,0"/>
                    <Button x:Name="LoadFileButton" Content="Load from File" Width="120" Margin="0,0,8,0"/>
                    <Button x:Name="SaveFileButton" Content="Save to File" Width="120" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshPreviewButton" Content="Refresh Preview" Width="120"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready." TextWrapping="Wrap"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabControl">
            <TabItem Header="Users">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="NewUserButton" Content="New User" Width="90" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteUserButton" Content="Delete User" Width="90"/>
                        </WrapPanel>
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="UID" Binding="{Binding UidNumber}" Width="90"/>
                                <DataGridTextColumn Header="Primary Group" Binding="{Binding PrimaryGroup}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="UserEditorGrid" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Name" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Given Name" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserGivenNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Surname" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserSurnameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Email (derived)" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserMailTextBox" Grid.Row="3" Grid.Column="1" Margin="0,3" IsReadOnly="True" Background="#F4F4F4"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="UID Number" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserUidTextBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="5" Grid.Column="0" Content="Primary Group" VerticalAlignment="Center"/>
                            <ComboBox x:Name="UserPrimaryGroupComboBox" Grid.Row="5" Grid.Column="1" Margin="0,3" IsEditable="True"/>

                            <Label Grid.Row="6" Grid.Column="0" Content="Other Groups" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <Border Grid.Row="6" Grid.Column="1" Margin="0,3" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                    <ItemsControl x:Name="UserOtherGroupsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0,2,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Label Grid.Row="7" Grid.Column="0" Content="Login Shell" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserLoginShellTextBox" Grid.Row="7" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="8" Grid.Column="0" Content="Home Directory" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserHomeDirTextBox" Grid.Row="8" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="9" Grid.Column="0" Content="Password" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                <PasswordBox x:Name="UserPasswordBox" Width="220" Margin="0,0,8,0"/>
                                <Button x:Name="GeneratePasswordHashButton" Content="Generate passbcrypt" Width="150"/>
                            </StackPanel>

                            <Label Grid.Row="10" Grid.Column="0" Content="passsha256" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserPassSha256TextBox" Grid.Row="10" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="11" Grid.Column="0" Content="passbcrypt" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserPassBcryptTextBox" Grid.Row="11" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="12" Grid.Column="0" Content="OTP Secret" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserOtpSecretTextBox" Grid.Row="12" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="13" Grid.Column="0" Content="YubiKey" VerticalAlignment="Center"/>
                            <TextBox x:Name="UserYubiKeyTextBox" Grid.Row="13" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="14" Grid.Column="0" Content="Disabled" VerticalAlignment="Center"/>
                            <CheckBox x:Name="UserDisabledCheckBox" Grid.Row="14" Grid.Column="1" Margin="0,6"/>

                            <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="SaveUserButton" Content="Save User" Width="110" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" Foreground="#606060" Text="Primary Group accepts a gid or an existing role name. Other Groups uses role checkboxes. Generating passbcrypt clears passsha256."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Roles">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="NewGroupButton" Content="New Role" Width="90" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteGroupButton" Content="Delete Role" Width="90"/>
                        </WrapPanel>
                        <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="GID" Binding="{Binding GidNumber}" Width="90"/>
                                <DataGridTextColumn Header="Included Groups" Binding="{Binding IncludeGroupsDisplay}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Role Name" VerticalAlignment="Center"/>
                            <TextBox x:Name="GroupNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="GID Number" VerticalAlignment="Center"/>
                            <TextBox x:Name="GroupGidTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Included Groups" VerticalAlignment="Center"/>
                            <TextBox x:Name="GroupIncludeGroupsTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="SaveGroupButton" Content="Save Role" Width="110" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" Foreground="#606060" Text="Included Groups accepts comma-separated gid values."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Config">
                <Grid Margin="8">
                    <TextBox x:Name="RawConfigTextBox" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" IsReadOnly="True" FontFamily="Consolas"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
